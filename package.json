    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "sharp": "^0.34.5",
    "simple-icons": "^16.30.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  }
