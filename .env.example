# Variables d'environnement — TOUTES optionnelles.
# Copier en .env.local pour les renseigner. Le site se construit et fonctionne
# sans aucune d'elles.
#
# Rappel : toute variable NEXT_PUBLIC_* est intégrée au JavaScript livré, donc
# lisible par n'importe quel visiteur. N'y mettre QUE des URL publiques, jamais
# de clé ni de secret.

# URL d'un service de formulaire (Formspree, Getform…) qui accepte un POST en
# JSON. Absente : le formulaire de contact affiche un lien mailto à la place.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# URL d'un proxy de détourage d'arrière-plan. Absente : le modèle local est
# utilisé (téléchargé une fois avec l'accord du visiteur, 54 Mo). Une URL,
# jamais une clé — le secret doit rester chez le proxy.
NEXT_PUBLIC_BG_REMOVAL_ENDPOINT=
